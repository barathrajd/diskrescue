{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskRescue",
  "version": "0.1.0",
  "identifier": "com.diskrescue.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiskRescue — Recovery workspace",
        "width": 1280,
        "height": 850,
        "minWidth": 760,
        "minHeight": 620
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
